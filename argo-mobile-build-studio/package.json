{
  "name": "@argo/mobile-build-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Herramienta local (solo desarrollo) para configurar marca/API de las apps móviles ARGO y lanzar builds EAS.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "apply": "node cli.mjs apply",
    "apply:all": "node cli.mjs apply --all",
    "build": "node cli.mjs build",
    "build:all": "node cli.mjs build --all"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2"
  }
}
